# discover plugins from upstream's actual graph, including new upstream modules
add_dependencies(lib_darktable dt_mobile_check_upstream)
foreach(_dt_kind IN ITEMS format storage)
  get_property(_dt_targets DIRECTORY "${CMAKE_SOURCE_DIR}/src/imageio/${_dt_kind}" PROPERTY BUILDSYSTEM_TARGETS)
  set(_dt_modules "")
  foreach(_dt_target IN LISTS _dt_targets)
    get_target_property(_dt_type ${_dt_target} TYPE)
    if(_dt_type STREQUAL "MODULE_LIBRARY")
      list(APPEND _dt_modules ${_dt_target})
    endif()
  endforeach()
  if(NOT _dt_modules)
    message(FATAL_ERROR "Upstream ${_dt_kind} plugin graph changed; review the Android integration")
  endif()
  string(TOUPPER "${_dt_kind}" _dt_kind_upper)
  set_property(GLOBAL PROPERTY DT_PLUGIN_${_dt_kind_upper}S "${_dt_modules}")
endforeach()
if(TARGET xcf)
  include("${CMAKE_SOURCE_DIR}/mobile/cmake/XcfWriter.cmake")
  dt_mobile_prepare_xcf_writer()
endif()
if(ANDROID)
  set_target_properties(lib_darktable PROPERTIES LINKER_LANGUAGE CXX)
  target_link_libraries(lib_darktable PUBLIC PkgConfig::DT_ANDROID_ENGINE)
  target_link_options(lib_darktable PRIVATE -Wl,--no-undefined)
  foreach(_dt_kind IN ITEMS iop format storage)
    string(TOUPPER "${_dt_kind}" _dt_kind_upper)
    get_property(_dt_modules GLOBAL PROPERTY DT_PLUGIN_${_dt_kind_upper}S)
    foreach(_dt_target IN LISTS _dt_modules)
      set_target_properties(${_dt_target} PROPERTIES PREFIX "libdt_${_dt_kind}_" INSTALL_RPATH "$ORIGIN")
    endforeach()
  endforeach()
endif()
